    </div> 

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Quick Facts -->
      <div class="bg-base-200 p-6 rounded-xl shadow-sm">
        <div class="mb-4">
          <h3 class="text-xl font-bold mb-2">Quick Facts</h3>
          <div class="w-12 h-1 bg-primary rounded-full"></div>
        </div>
        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <span class="font-medium text-right">Based in:</span>
          <span>United States</span>
          
          <span class="font-medium text-right">Focus Areas:</span>
          <span>Tech, Whatever Catches My Eye</span>
          
          <span class="font-medium text-right">Learning Style:</span>
          <span>Hands-on figure-it-outer</span>
          
          <span class="font-medium text-right">Starbucks Order:</span>
          <span>Pinkest drink on the menu</span>
        </div>
      </div>

      <!-- Current Interests -->
      <div class="bg-base-200 p-6 rounded-xl shadow-sm">
        <div class="mb-4">
          <h3 class="text-xl font-bold mb-2">Currently Exploring</h3>
          <div class="w-12 h-1 bg-primary rounded-full"></div>
        </div>
        <div class="flex flex-wrap gap-2">
          <span class="inline-flex items-center px-3 py-1 bg-primary/10 text-primary rounded-full text-xs font-medium border border-primary/20">Azure AI Services</span>
          <span class="inline-flex items-center px-3 py-1 bg-secondary/10 text-secondary rounded-full text-xs font-medium border border-secondary/20">Logic Apps</span>
          <span class="inline-flex items-center px-3 py-1 bg-accent/10 text-accent rounded-full text-xs font-medium border border-accent/20">Function Apps</span>
          <span class="inline-flex items-center px-3 py-1 bg-info/10 text-info rounded-full text-xs font-medium border border-info/20">Power Platform</span>
          <span class="inline-flex items-center px-3 py-1 bg-success/10 text-success rounded-full text-xs font-medium border border-success/20">Container Apps</span>
          <span class="inline-flex items-center px-3 py-1 bg-warning/10 text-warning rounded-full text-xs font-medium border border-warning/20">DevOps Automation</span>
        </div>
      </div>

      <!-- Connect -->
      <div class="bg-base-200 p-6 rounded-xl shadow-sm">
        <div class="mb-4">
          <h3 class="text-xl font-bold mb-2">Let's Connect</h3>
          <div class="w-12 h-1 bg-primary rounded-full"></div>
        </div>
        <p class="text-sm mb-4 leading-relaxed">
          Have a question about a post? Want to share your own discoveries? 
          I love connecting with fellow explorers!
        </p>
        
        <div class="space-y-3">
          <a href="https://github.com/hibbertda" class="flex items-center p-3 bg-base-100 rounded-lg hover:bg-primary hover:text-primary-content transition-all duration-300 shadow-sm hover:shadow-md" target="_blank">
            <svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <div class="flex-1 text-left">
              <div class="font-medium">GitHub</div>
              <div class="text-xs opacity-75">Check out my projects</div>
            </div>
          </a>
          
          <a href="https://linkedin.com/in/your-profile" class="flex items-center p-3 bg-base-100 rounded-lg hover:bg-secondary hover:text-secondary-content transition-all duration-300 shadow-sm hover:shadow-md" target="_blank">
            <svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <div class="flex-1 text-left">
              <div class="font-medium">LinkedIn</div>
              <div class="text-xs opacity-75">Professional connections</div>
            </div>
          </a>
        </div>
      </div>

      <!-- Fun Facts -->
       <!-- I like this but need to think about what to put here -->
