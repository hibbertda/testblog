        <span class="px-3 py-2 bg-primary/10 text-primary rounded-full text-sm text-center">Skill Name</span>
        <span class="px-3 py-2 bg-primary/10 text-primary rounded-full text-sm text-center">Skill Name</span>
        <span class="px-3 py-2 bg-primary/10 text-primary rounded-full text-sm text-center">Skill Name</span>
