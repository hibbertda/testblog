---
import SideBarFooter from "./SideBarFooter.astro";
import ThemeSelector from "./ThemeSelector.astro";
import { Image } from "astro:assets";
import SideBarMenu from "./SideBarMenu.astro";
const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="px-2 pt-2 h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col">
    <div class="w-fit mx-auto mt-5 mb-6">
      <a href="/">
        <div class="transition ease-in-out hover:scale-[102%] block m-auto relative">
          <!-- Rounded box background matching hero image background -->
          <div class="bg-cover bg-center bg-no-repeat rounded-2xl p-0.5 shadow-lg" style="background-image: url('/nae_heroBackground.png')">
            <div class="w-[17rem] relative z-10">
              <Image class="mask mask-circle" format="webp" width={400} height={400} src="/nae_logo.png" alt="Profile image" />
            </div>
          </div>
        </div>
      </a>
    </div>
    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    
    <!-- Featured Topics Section -->
    <div class="mt-8 mb-8">
      <div class="px-2 mb-6">
        <h3 class="text-lg font-bold mb-2">Featured Topics</h3>
        <div class="w-12 h-1 bg-blue-600 rounded-full"></div>
      </div>
      <div class="space-y-3">
        <a href="/blog/tag/Azure" class="block p-4 mx-2 bg-base-100 rounded-xl hover:bg-blue-600 hover:text-white transition-all duration-300 shadow-sm hover:shadow-md">
          <div class="flex items-center justify-between">
            <div>
              <div class="font-semibold text-base">Azure Adventures</div>
              <div class="text-xs opacity-75 mt-1">Cloud architecture & solutions</div>
            </div>
            <div class="w-2 h-2 bg-current rounded-full opacity-50"></div>
          </div>
        </a>
        
        <a href="/blog/tag/AI" class="block p-4 mx-2 bg-base-100 rounded-xl hover:bg-blue-600 hover:text-white transition-all duration-300 shadow-sm hover:shadow-md">
          <div class="flex items-center justify-between">
            <div>
              <div class="font-semibold text-base">AI Experiments</div>
              <div class="text-xs opacity-75 mt-1">Machine learning & automation</div>
            </div>
            <div class="w-2 h-2 bg-current rounded-full opacity-50"></div>
          </div>
        </a>
        
        <a href="/blog/tag/logic apps" class="block p-4 mx-2 bg-base-100 rounded-xl hover:bg-blue-600 hover:text-white transition-all duration-300 shadow-sm hover:shadow-md">
          <div class="flex items-center justify-between">
            <div>
              <div class="font-semibold text-base">Logic Apps</div>
              <div class="text-xs opacity-75 mt-1">Workflow automation</div>
            </div>
            <div class="w-2 h-2 bg-current rounded-full opacity-50"></div>
          </div>
        </a>
      </div>
    </div>
    
    <!-- Theme Selector in Sidebar -->
    <div class="mt-auto mb-4 flex justify-center">
      <ThemeSelector />
    </div>
    
    <SideBarFooter />
  </aside>
</div>
