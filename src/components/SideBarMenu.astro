---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-blue-600 text-white"; // Enhanced active styling with complementary blue
---

<ul class="menu grow shrink menu-md overflow-y-auto space-y-3">
    <li>
        <a class="block p-4 mx-2 bg-base-100 rounded-xl hover:bg-blue-600 hover:text-white transition-all duration-300 shadow-sm hover:shadow-md" id="home" href="/">
            <div class="flex items-center justify-between">
                <div>
                    <div class="font-semibold text-base">Home</div>
                    <div class="text-xs opacity-75 mt-1">Welcome & latest posts</div>
                </div>
                <div class="w-2 h-2 bg-current rounded-full opacity-50"></div>
            </div>
        </a>
    </li>
    <li>
        <a class="block p-4 mx-2 bg-base-100 rounded-xl hover:bg-blue-600 hover:text-white transition-all duration-300 shadow-sm hover:shadow-md" id="about" href="/about">
            <div class="flex items-center justify-between">
                <div>
                    <div class="font-semibold text-base">About</div>
                    <div class="text-xs opacity-75 mt-1">My story & approach</div>
                </div>
                <div class="w-2 h-2 bg-current rounded-full opacity-50"></div>
            </div>
        </a>
    </li>
    <li>
        <a class="block p-4 mx-2 bg-base-100 rounded-xl hover:bg-blue-600 hover:text-white transition-all duration-300 shadow-sm hover:shadow-md" id="blog" href="/blog/">
            <div class="flex items-center justify-between">
                <div>
                    <div class="font-semibold text-base">Blog</div>
                    <div class="text-xs opacity-75 mt-1">All articles & posts</div>
                </div>
                <div class="w-2 h-2 bg-current rounded-full opacity-50"></div>
            </div>
        </a>
    </li>
    <!-- <li><a class="py-3 text-base" id="projects" href="/projects">Projects</a></li> -->
    <!-- <li><a class="py-3 text-base" id="services" href="/services">Services</a></li>
    <li><a class="py-3 text-base" id="store" href="/store">Store</a></li> -->
    <!-- <li><a class="py-3 text-base" id="cv" href="/cv">CV</a></li> -->
</ul>

<script define:vars={{ sideBarActiveItemID: sideBarActiveItemID, activeClass: activeClass }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
if (activeItemElem) {
    // Add active styling by modifying the classes of the link element
    activeItemElem.classList.add('bg-blue-600', 'text-white');
    activeItemElem.classList.remove('bg-base-100', 'hover:bg-primary', 'hover:bg-secondary', 'hover:bg-accent');
}
</script>
