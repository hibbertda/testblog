---
export interface Props {
  type?: 'note' | 'warning' | 'tip' | 'error' | 'info';
  title?: string;
  class?: string;
}

const { 
  type = 'note', 
  title,
  class: className
} = Astro.props;

const typeConfig = {
  note: {
    class: 'callout-note',
    icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    defaultTitle: 'Note'
  },
  info: {
    class: 'callout-info',
    icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    defaultTitle: 'Information'
  },
  warning: {
    class: 'callout-warning', 
    icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z',
    defaultTitle: 'Warning'
  },
  tip: {
    class: 'callout-tip',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
    defaultTitle: 'Tip'
  },
  error: {
    class: 'callout-error',
    icon: 'M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z',
    defaultTitle: 'Error'
  }
};

const config = typeConfig[type];
---

<div class={`flex items-start gap-4 p-5 ${config.class} my-6 rounded-lg shadow-md ${className || ''}`}>
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-6 h-6 mt-0.5 flex-shrink-0">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" stroke="currentColor" d={config.icon}></path>
  </svg>
  <div class="flex-1">
    {title && (
      <div class="font-bold text-sm uppercase tracking-wide mb-2">
        {title}
      </div>
    )}
    <div class="leading-relaxed">
      <slot />
    </div>
  </div>
</div>
